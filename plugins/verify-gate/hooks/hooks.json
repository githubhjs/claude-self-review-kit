{
  "description": "Block Claude from stopping while the project's .claude/verify.sh fails",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/verify-gate.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
